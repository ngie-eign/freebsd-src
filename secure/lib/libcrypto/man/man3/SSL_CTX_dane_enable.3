.Fo SSL_get0_dane_tlsa
.Fa "SSL *s"
.Fa "uint8_t *usage"
.Fa "uint8_t *selector"
.Fa "uint8_t *mtype"
.Fa "const unsigned char **data"
.Fa "size_t *dlen"
.Fc
