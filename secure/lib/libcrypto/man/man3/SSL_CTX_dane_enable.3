.Dd 2025-09-30
.Dt SSL_CTX_DANE_ENABLE 3ossl
.Os
.Sh NAME
.Nm SSL_CTX_dane_enable ,
.Nm SSL_CTX_dane_mtype_set ,
.Nm SSL_dane_enable ,
.Nm SSL_dane_tlsa_add ,
.Nm SSL_get0_dane_authority ,
.Nm SSL_get0_dane_tlsa ,
.Nm SSL_CTX_dane_set_flags ,
.Nm SSL_CTX_dane_clear_flags ,
.Nm SSL_dane_set_flags ,
.Nm SSL_dane_clear_flags
.Nd enable DANE TLS authentication of the remote TLS server in the local TLS client
.Sh SYNOPSIS
.In openssl/ssl.h
.Ft int
.Fo SSL_CTX_dane_enable
.Fa "SSL_CTX *ctx"
.Fc
.Ft int
.Fo SSL_CTX_dane_mtype_set
.Fa "SSL_CTX *ctx"
.Fa "const EVP_MD *md"
.Fa "uint8_t mtype"
.Fa "uint8_t ord"
.Fc
.Ft int
.Fo SSL_dane_enable
.Fa "SSL *s"
.Fa "const char *basedomain"
.Fc
.Ft int
.Fo SSL_dane_tlsa_add
.Fa "SSL *s"
.Fa "uint8_t usage"
.Fa "uint8_t selector"
.Fa "uint8_t mtype"
.Fa "const unsigned char *data"
.Fa "size_t dlen"
.Fc
