.Dd 2025-09-30
.Dt BIO_SET_CALLBACK 3ossl
.Os
.Sh NAME
.Nm BIO_set_callback_ex ,
.Nm BIO_get_callback_ex ,
.Nm BIO_set_callback ,
.Nm BIO_get_callback ,
.Nm BIO_set_callback_arg ,
