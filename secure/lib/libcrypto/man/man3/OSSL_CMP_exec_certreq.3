.Dd 2025-09-30
.Dt OSSL_CMP_EXEC_CERTREQ 3ossl
.Os
.Sh NAME
.Nm OSSL_CMP_exec_certreq ,
.Nm OSSL_CMP_exec_IR_ses ,
.Nm OSSL_CMP_exec_CR_ses ,
.Nm OSSL_CMP_exec_P10CR_ses ,
.Nm OSSL_CMP_exec_KUR_ses ,
.Nm OSSL_CMP_IR ,
.Nm OSSL_CMP_CR ,
.Nm OSSL_CMP_P10CR ,
.Nm OSSL_CMP_KUR ,
.Nm OSSL_CMP_try_certreq ,
.Nm OSSL_CMP_exec_RR_ses ,
.Nm OSSL_CMP_exec_GENM_ses ,
.Nm OSSL_CMP_get1_caCerts ,
.Nm OSSL_CMP_get1_rootCaKeyUpdate ,
.Nm OSSL_CMP_get1_crlUpdate ,
.Nm OSSL_CMP_get1_certReqTemplate
.Nd functions implementing CMP client transactions
.Sh SYNOPSIS
.In openssl/cmp.h
.Ft X509 *
.Fo OSSL_CMP_exec_certreq
.Fa "OSSL_CMP_CTX *ctx"
.Fa "int req_type"
.Fa "const OSSL_CRMF_MSG *crm"
.Fc
.Ft X509 *
.Fo OSSL_CMP_exec_IR_ses
.Fa "OSSL_CMP_CTX *ctx"
.Fc
.Ft X509 *
.Fo OSSL_CMP_exec_CR_ses
.Fa "OSSL_CMP_CTX *ctx"
.Fc
.Ft X509 *
.Fo OSSL_CMP_exec_P10CR_ses
.Fa "OSSL_CMP_CTX *ctx"
.Fc
.Ft X509 *
.Fo OSSL_CMP_exec_KUR_ses
.Fa "OSSL_CMP_CTX *ctx"
.Fc
.Fd #define OSSL_CMP_IR
.Fd #define OSSL_CMP_CR
.Fd #define OSSL_CMP_P10CR
.Fd #define OSSL_CMP_KUR
.Ft int
.Fo OSSL_CMP_try_certreq
.Fa "OSSL_CMP_CTX *ctx"
.Fa "int req_type"
.Fa "const OSSL_CRMF_MSG *crm"
.Fa "int *checkAfter"
.Fc
.Ft int
.Fo OSSL_CMP_exec_RR_ses
.Fa "OSSL_CMP_CTX *ctx"
.Fc
.Bd -literal
