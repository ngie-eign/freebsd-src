.Nd Type and functions to create OSSL_STORE search criteria
.Sh SYNOPSIS
.In openssl/store.h
.Ft typedef struct ossl_store_search_st OSSL_STORE_SEARCH;

 OSSL_STORE_SEARCH *
.Fo OSSL_STORE_SEARCH_by_name
.Fa "X509_NAME *name"
.Fc
.Ft OSSL_STORE_SEARCH *
.Fo OSSL_STORE_SEARCH_by_issuer_serial
.Fa "X509_NAME *name"
.Fa "const ASN1_INTEGER                                                        *serial"
.Fc
.Ft OSSL_STORE_SEARCH *
.Fo OSSL_STORE_SEARCH_by_key_fingerprint
.Fa "const EVP_MD *digest"
.Fa "const unsigned char                                                          *bytes"
.Fa "int len"
.Fc
.Ft OSSL_STORE_SEARCH *
