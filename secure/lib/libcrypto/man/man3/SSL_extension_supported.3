.Dd 2025-09-30
.Dt SSL_EXTENSION_SUPPORTED 3ossl
.Os
.Sh NAME
.Nm SSL_extension_supported ,
.Nm SSL_custom_ext_add_cb_ex ,
.Nm SSL_custom_ext_free_cb_ex ,
.Nm SSL_custom_ext_parse_cb_ex ,
.Nm SSL_CTX_add_custom_ext ,
.Nm SSL_CTX_add_client_custom_ext ,
.Nm SSL_CTX_add_server_custom_ext ,
.Nm custom_ext_add_cb ,
.Nm custom_ext_free_cb ,
.Nm custom_ext_parse_cb
.Nd custom TLS extension handling
.Sh SYNOPSIS
.In openssl/ssl.h
.Ft typedef int
.Fo 
.Fa *SSL_custom_ext_add_cb_ex
.Fc
(SSL *s, unsigned int ext_type,
.Bd -literal
                                         unsigned int context,
                                         const unsigned char **out,
                                         size_t *outlen, X509 *x,
                                         size_t chainidx, int *al,
                                         void *add_arg);
.Ed
.Ft typedef void
.Fo 
.Fa *SSL_custom_ext_free_cb_ex
.Fc
(SSL *s, unsigned int ext_type,
.Bd -literal
                                           unsigned int context,
                                           const unsigned char *out,
                                           void *add_arg);
.Ed
.Ft typedef int
.Fo 
.Fa *SSL_custom_ext_parse_cb_ex
.Fc
(SSL *s, unsigned int ext_type,
.Bd -literal
                                           unsigned int context,
                                           const unsigned char *in,
                                           size_t inlen, X509 *x,
                                           size_t chainidx, int *al,
                                           void *parse_arg);
.Ed
.Ft int
.Fo SSL_CTX_add_custom_ext
.Fa "SSL_CTX *ctx"
.Fa "unsigned int ext_type"
.Fa "unsigned int context"
.Fa "SSL_custom_ext_add_cb_ex add_cb"
.Fa "SSL_custom_ext_free_cb_ex free_cb"
.Fa "void *add_arg"
.Fa "SSL_custom_ext_parse_cb_ex parse_cb"
.Fa "void *parse_arg"
.Fc
