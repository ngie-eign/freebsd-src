.Nm OPENSSL_thread_stop_ex ,
.Nm OPENSSL_thread_stop
.Nd OpenSSL initialisation and deinitialisation functions
.Sh SYNOPSIS
.In openssl/crypto.h
.Ft void
.Fo OPENSSL_cleanup
.Fa void
.Fc
