.Sh NAME
.Nm X509V3_get_d2i ,
.Nm X509V3_add1_i2d ,
.Nm X509V3_EXT_d2i ,
.Nm X509V3_EXT_i2d ,
.Nm X509_get_ext_d2i ,
.Nm X509_add1_ext_i2d ,
.Nm X509_ACERT_get_ext_d2i ,
.Nm X509_ACERT_add1_ext_i2d ,
.Nm X509_CRL_get_ext_d2i ,
