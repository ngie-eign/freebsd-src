.Dd 2025-09-30
.Dt SSL_CTX_SET_CT_VALIDATION_CALLBACK 3ossl
.Os
.Sh NAME
.Nm ssl_ct_validation_cb ,
.Nm SSL_enable_ct ,
.Nm SSL_CTX_enable_ct ,
.Nm SSL_disable_ct ,
.Nm SSL_CTX_disable_ct ,
.Nm SSL_set_ct_validation_callback ,
.Nm SSL_CTX_set_ct_validation_callback ,
.Nm SSL_ct_is_enabled ,
.Nm SSL_CTX_ct_is_enabled
.Nd control Certificate Transparency policy
.Sh SYNOPSIS
.In openssl/ssl.h
.Ft typedef int
.Fo 
.Fa *ssl_ct_validation_cb
.Fc
(const CT_POLICY_EVAL_CTX *ctx,
.Ft const
.Fo STACK_OF
.Fa SCT
.Fc
 *scts, void *arg);
.Ft int
.Fo SSL_enable_ct
.Fa "SSL *s"
.Fa "int validation_mode"
.Fc
.Ft int
.Fo SSL_CTX_enable_ct
.Fa "SSL_CTX *ctx"
.Fa "int validation_mode"
.Fc
.Ft int
.Fo SSL_set_ct_validation_callback
.Fa "SSL *s"
.Fa "ssl_ct_validation_cb callback"
.Fa "void *arg"
.Fc
.Ft int
.Fo SSL_CTX_set_ct_validation_callback
.Fa "SSL_CTX *ctx"
.Fa "ssl_ct_validation_cb callback"
.Fa "void *arg"
.Fc
.Ft void
.Fo SSL_disable_ct
.Fa "SSL *s"
.Fc
.Ft void
.Fo SSL_CTX_disable_ct
.Fa "SSL_CTX *ctx"
.Fc
