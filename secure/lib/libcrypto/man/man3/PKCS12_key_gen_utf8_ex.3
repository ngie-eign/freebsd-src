.Fo PKCS12_key_gen_utf8_ex
.Fa "const char *pass"
.Fa "int passlen"
.Fa "unsigned char *salt"
.Fa "int saltlen"
.Fa "int id"
.Fa "int iter"
.Fa "int n"
.Fa "unsigned char *out"
.Fa "const EVP_MD *md_type"
