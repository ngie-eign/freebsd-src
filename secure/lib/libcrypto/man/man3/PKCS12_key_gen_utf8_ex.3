.Sh NAME
.Nm PKCS12_key_gen_asc ,
.Nm PKCS12_key_gen_asc_ex ,
.Nm PKCS12_key_gen_uni ,
.Nm PKCS12_key_gen_uni_ex ,
.Nm PKCS12_key_gen_utf8 ,
.Nm PKCS12_key_gen_utf8_ex
.Nd PKCS#12 Password based key derivation
.Sh SYNOPSIS
.In openssl/pkcs12.h
.Ft int
.Fo PKCS12_key_gen_asc
.Fa "const char *pass"
.Fa "int passlen"
.Fa "unsigned char *salt"
.Fa "int saltlen"
.Fa "int id"
.Fa "int iter"
.Fa "int n"
.Fa "unsigned char *out"
.Fa "const EVP_MD *md_type"
.Fc
.Ft int
.Fo PKCS12_key_gen_asc_ex
