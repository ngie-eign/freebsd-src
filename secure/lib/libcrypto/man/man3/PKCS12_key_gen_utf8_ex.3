.Fa "int iter"
.Fa "int n"
.Fa "unsigned char *out"
.Fa "const EVP_MD *md_type"
.Fa "OSSL_LIB_CTX *ctx"
.Fa "const char *propq"
.Fc
.Ft int
.Fo PKCS12_key_gen_uni
