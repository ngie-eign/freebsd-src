.Dd 2025-09-30
.Dt CT_POLICY_EVAL_CTX_NEW 3ossl
.Os
.Sh NAME
.Nm CT_POLICY_EVAL_CTX_new_ex ,
.Nm CT_POLICY_EVAL_CTX_new ,
.Nm CT_POLICY_EVAL_CTX_free ,
.Nm CT_POLICY_EVAL_CTX_get0_cert ,
.Nm CT_POLICY_EVAL_CTX_set1_cert ,
.Nm CT_POLICY_EVAL_CTX_get0_issuer ,
