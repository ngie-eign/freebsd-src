.Dd 2025-09-30
.Dt SSL_CTX_SET_SRP_PASSWORD 3ossl
.Os
.Sh NAME
.Nm SSL_CTX_set_srp_username ,
.Nm SSL_CTX_set_srp_password ,
.Nm SSL_CTX_set_srp_strength ,
.Nm SSL_CTX_set_srp_cb_arg ,
.Nm SSL_CTX_set_srp_username_callback ,
.Nm SSL_CTX_set_srp_client_pwd_callback ,
.Nm SSL_CTX_set_srp_verify_param_callback ,
.Nm SSL_set_srp_server_param ,
.Nm SSL_set_srp_server_param_pw ,
.Nm SSL_get_srp_g ,
.Nm SSL_get_srp_N ,
.Nm SSL_get_srp_username ,
.Nm SSL_get_srp_userinfo
.Nd SRP control operations
.Sh SYNOPSIS
.In openssl/ssl.h
The following functions have been deprecated since OpenSSL 3.0, and can
be hidden entirely by defining
.Ar OPENSSL_API_COMPAT
with a suitable version value, see
.Xr openssl_user_macros 7 :
.Ft int
.Fo SSL_CTX_set_srp_username
.Fa "SSL_CTX *ctx"
.Fa "char *name"
.Fc
.Ft int
.Fo SSL_CTX_set_srp_password
.Fa "SSL_CTX *ctx"
.Fa "char *password"
.Fc
.Ft int
.Fo SSL_CTX_set_srp_strength
.Fa "SSL_CTX *ctx"
.Fa "int strength"
.Fc
.Ft int
.Fo SSL_CTX_set_srp_cb_arg
.Fa "SSL_CTX *ctx"
.Fa "void *arg"
.Fc
.Ft int
.Fo SSL_CTX_set_srp_username_callback
.Fa "SSL_CTX *ctx"
.Fa "int (*cb) (SSL *s"
.Fa "int *ad"
.Fa "void *arg)"
.Fc
.Ft int
.Fo SSL_CTX_set_srp_client_pwd_callback
.Fa "SSL_CTX *ctx"
.Fa "char *(*cb) (SSL *s"
.Fa "void *arg)"
.Fc
.Ft int
.Fo SSL_CTX_set_srp_verify_param_callback
.Fa "SSL_CTX *ctx"
.Fa "int (*cb) (SSL *s"
.Fa "void *arg)"
.Fc
.Ft int
.Fo SSL_set_srp_server_param
.Fa "SSL *s"
.Fa "const BIGNUM *N"
.Fa "const BIGNUM *g"
.Fa "BIGNUM *sa"
.Fa "BIGNUM *v"
.Fa "char *info"
.Fc
.Ft int
