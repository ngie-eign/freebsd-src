.Fa "SSL *s"
.Fa "const char *user"
.Fa "const char *pass"
.Fa "const char *grp"
.Fc
.Ft BIGNUM *
.Fo SSL_get_srp_g
.Fa "SSL *s"
.Fc
.Ft BIGNUM *
.Fo SSL_get_srp_N
.Fa "SSL *s"
.Fc
