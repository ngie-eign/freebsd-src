.Nd Routines for getting and setting data in a DH object
.Sh SYNOPSIS
.In openssl/dh.h
The following functions have been deprecated since OpenSSL 3.0, and can
be hidden entirely by defining
.Ar OPENSSL_API_COMPAT
with a suitable version value, see
.Xr openssl_user_macros 7 :
.Ft void
.Fo DH_get0_pqg
.Fa "const DH *dh"
.Fa "const BIGNUM **p"
.Fa "const BIGNUM **q"
.Fa "const BIGNUM **g"
.Fc
.Ft int
.Fo DH_set0_pqg
.Fa "DH *dh"
.Fa "BIGNUM *p"
.Fa "BIGNUM *q"
.Fa "BIGNUM *g"
.Fc
.Ft void
.Fo DH_get0_key
.Fa "const DH *dh"
.Fa "const BIGNUM **pub_key"
.Fa "const BIGNUM **priv_key"
.Fc
.Ft int
.Fo DH_set0_key
.Fa "DH *dh"
.Fa "BIGNUM *pub_key"
.Fa "BIGNUM *priv_key"
.Fc
.Ft const BIGNUM *
.Fo DH_get0_p
.Fa "const DH *dh"
.Fc
.Ft const BIGNUM *
.Fo DH_get0_q
.Fa "const DH *dh"
.Fc
.Ft const BIGNUM *
.Fo DH_get0_g
.Fa "const DH *dh"
.Fc
.Ft const BIGNUM *
.Fo DH_get0_priv_key
.Fa "const DH *dh"
.Fc
.Ft const BIGNUM *
.Fo DH_get0_pub_key
.Fa "const DH *dh"
.Fc
.Ft void
.Fo DH_clear_flags
.Fa "DH *dh"
.Fa "int flags"
.Fc
.Ft int
.Fo DH_test_flags
.Fa "const DH *dh"
.Fa "int flags"
.Fc
