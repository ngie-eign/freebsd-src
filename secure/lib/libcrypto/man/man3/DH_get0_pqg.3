.Dt DH_GET0_PQG 3ossl
.Os
.Sh NAME
.Nm DH_get0_pqg ,
.Nm DH_set0_pqg ,
.Nm DH_get0_key ,
.Nm DH_set0_key ,
.Nm DH_get0_p ,
.Nm DH_get0_q ,
