.Dd 2025-09-30
.Dt SSL_CTX_SET_TMP_ECDH 3ossl
.Os
.Sh NAME
.Nm SSL_CTX_set_tmp_ecdh ,
.Nm SSL_set_tmp_ecdh ,
.Nm SSL_CTX_set_ecdh_auto ,
.Nm SSL_set_ecdh_auto
.Nd handle ECDH keys for ephemeral key exchange
.Sh SYNOPSIS
.In openssl/ssl.h
.Ft long
.Fo SSL_CTX_set_tmp_ecdh
.Fa "SSL_CTX *ctx"
.Fa "const EC_KEY *ecdh"
.Fc
.Ft long
.Fo SSL_set_tmp_ecdh
.Fa "SSL *ssl"
.Fa "const EC_KEY *ecdh"
.Fc
.Ft long
.Fo SSL_CTX_set_ecdh_auto
.Fa "SSL_CTX *ctx"
.Fa "int state"
.Fc
.Ft long
.Fo SSL_set_ecdh_auto
.Fa "SSL *ssl"
.Fa "int state"
.Fc
.Sh DESCRIPTION
.Fn SSL_CTX_set_tmp_ecdh
sets ECDH parameters to be used to be
.Fa ecdh .
The key is inherited by all
.Fa ssl
objects created from
.Fa ctx .
This macro is deprecated in favor of
.Xr SSL_CTX_set1_groups 3 .
.Pp
.Fn SSL_set_tmp_ecdh
sets the parameters only for
.Fa ssl .
This macro is deprecated in favor of
.Xr SSL_set1_groups 3 .
.Pp
.Fn SSL_CTX_set_ecdh_auto
and
.Fn SSL_set_ecdh_auto
are deprecated and have no effect.
.Sh RETURN VALUES
.Fn SSL_CTX_set_tmp_ecdh
and
.Fn SSL_set_tmp_ecdh
return 1 on success and 0 on failure.
.Sh SEE ALSO
.Xr ssl 7 ,
.Xr SSL_CTX_set1_curves 3 ,
.Xr SSL_CTX_set_cipher_list 3 ,
.Xr SSL_CTX_set_options 3 ,
.Xr SSL_CTX_set_tmp_dh_callback 3 ,
.Xr openssl-ciphers 1 ,
.Xr openssl-ecparam 1
