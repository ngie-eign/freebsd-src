.Nd HTTP client low-level functions
.Sh SYNOPSIS
.In openssl/http.h
.Ft typedef struct ossl_http_req_ctx_st OSSL_HTTP_REQ_CTX;

 OSSL_HTTP_REQ_CTX *
.Fo OSSL_HTTP_REQ_CTX_new
