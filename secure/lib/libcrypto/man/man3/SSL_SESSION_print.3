.Dd 2025-09-30
.Dt SSL_SESSION_PRINT 3ossl
.Os
.Sh NAME
.Nm SSL_SESSION_print ,
.Nm SSL_SESSION_print_fp ,
.Nm SSL_SESSION_print_keylog
.Nd printf information about a session
.Sh SYNOPSIS
.In openssl/ssl.h
.Ft int
.Fo SSL_SESSION_print
.Fa "BIO *fp"
.Fa "const SSL_SESSION *ses"
.Fc
.Ft int
.Fo SSL_SESSION_print_fp
.Fa "FILE *fp"
.Fa "const SSL_SESSION *ses"
.Fc
.Ft int
.Fo SSL_SESSION_print_keylog
.Fa "BIO *bp"
.Fa "const SSL_SESSION *x"
.Fc
.Sh DESCRIPTION
.Fn SSL_SESSION_print
prints summary information about the session provided in
.Fa ses
to the BIO
.Fa fp .
.Pp
.Fn SSL_SESSION_print_fp
does the same as
.Fn SSL_SESSION_print
except it prints it to the FILE
.Fa fp .
.Pp
.Fn SSL_SESSION_print_keylog
prints session information to the provided BIO <bp> in NSS keylog
format.
.Sh RETURN VALUES
.Fn SSL_SESSION_print ,
.Fn SSL_SESSION_print_fp
and SSL_SESSION_print_keylog return 1 on success or 0 on error.
.Sh SEE ALSO
.Xr ssl 7
