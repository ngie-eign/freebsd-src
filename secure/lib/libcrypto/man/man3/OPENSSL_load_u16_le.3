.Os
.Sh NAME
.Nm OPENSSL_load_u16_le ,
.Nm OPENSSL_load_u16_be ,
.Nm OPENSSL_load_u32_le ,
.Nm OPENSSL_load_u32_be ,
.Nm OPENSSL_load_u64_le ,
