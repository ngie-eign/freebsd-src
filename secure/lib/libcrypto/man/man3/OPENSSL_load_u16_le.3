.Nm OPENSSL_store_u64_le ,
.Nm OPENSSL_store_u64_be
.Nd Read and write unsigned 16, 32 and 64-bit integers in a specific byte order
.Sh SYNOPSIS
.In openssl/byteorder.h
.Ft static ossl_inline unsigned char *
.Fo OPENSSL_store_u16_le
.Fa "         unsigned char *out"
.Fa "uint16_t val"
.Fc
.Ft static ossl_inline unsigned char *
.Fo OPENSSL_store_u16_be
.Fa "         unsigned char *out"
.Fa "uint16_t val"
.Fc
.Ft static ossl_inline unsigned char *
.Fo OPENSSL_store_u32_le
.Fa "         unsigned char *out"
.Fa "uint32_t val"
.Fc
.Ft static ossl_inline unsigned char *
.Fo OPENSSL_store_u32_be
.Fa "         unsigned char *out"
.Fa "uint32_t val"
.Fc
.Ft static ossl_inline unsigned char *
.Fo OPENSSL_store_u64_le
.Fa "         unsigned char *out"
.Fa "uint64_t val"
.Fc
.Ft static ossl_inline unsigned char *
.Fo OPENSSL_store_u64_be
.Fa "         unsigned char *out"
.Fa "uint64_t val"
.Fc
.Ft static ossl_inline const unsigned char *
.Fo OPENSSL_load_u16_le
.Fa "         uint16_t *val"
.Fa "const unsigned char *in"
.Fc
.Ft static ossl_inline const unsigned char *
.Fo OPENSSL_load_u16_be
