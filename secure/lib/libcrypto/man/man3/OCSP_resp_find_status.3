.Dd 2025-09-30
.Dt OCSP_RESP_FIND_STATUS 3ossl
.Os
.Sh NAME
.Nm OCSP_resp_find_status ,
.Nm OCSP_resp_count ,
.Nm OCSP_resp_get0 ,
.Nm OCSP_resp_find ,
.Nm OCSP_single_get0_status ,
.Nm OCSP_resp_get0_produced_at ,
.Nm OCSP_resp_get0_signature ,
.Nm OCSP_resp_get0_tbs_sigalg ,
.Nm OCSP_resp_get0_respdata ,
.Nm OCSP_resp_get0_certs ,
.Nm OCSP_resp_get0_signer ,
.Nm OCSP_resp_get0_id ,
.Nm OCSP_resp_get1_id ,
.Nm OCSP_check_validity ,
.Nm OCSP_basic_verify
.Nd OCSP response utility functions
.Sh SYNOPSIS
.In openssl/ocsp.h
.Ft int
.Fo OCSP_resp_find_status
.Fa "OCSP_BASICRESP *bs"
.Fa "OCSP_CERTID *id"
.Fa "int *status"
.Fa "int *reason"
.Fa "ASN1_GENERALIZEDTIME **revtime"
.Fa "ASN1_GENERALIZEDTIME **thisupd"
.Fa "ASN1_GENERALIZEDTIME **nextupd"
.Fc
.Ft int
.Fo OCSP_resp_count
.Fa "OCSP_BASICRESP *bs"
.Fc
.Ft OCSP_SINGLERESP *
.Fo OCSP_resp_get0
.Fa "OCSP_BASICRESP *bs"
.Fa "int idx"
.Fc
.Ft int
.Fo OCSP_resp_find
.Fa "OCSP_BASICRESP *bs"
.Fa "OCSP_CERTID *id"
.Fa "int last"
.Fc
.Ft int
.Fo OCSP_single_get0_status
.Fa "OCSP_SINGLERESP *single"
.Fa "int *reason"
.Fa "ASN1_GENERALIZEDTIME **revtime"
.Fa "ASN1_GENERALIZEDTIME **thisupd"
.Fa "ASN1_GENERALIZEDTIME **nextupd"
.Fc
.Ft const ASN1_GENERALIZEDTIME *
.Fo OCSP_resp_get0_produced_at
.Fa "                              const OCSP_BASICRESP* single"
.Fc
.Ft const ASN1_OCTET_STRING *
.Fo OCSP_resp_get0_signature
.Fa "const OCSP_BASICRESP *bs"
.Fc
.Ft const X509_ALGOR *
.Fo OCSP_resp_get0_tbs_sigalg
.Fa "const OCSP_BASICRESP *bs"
.Fc
.Ft const OCSP_RESPDATA *
.Fo OCSP_resp_get0_respdata
.Fa "const OCSP_BASICRESP *bs"
.Fc
.Ft const
.Fo STACK_OF
.Fa X509
.Fc
 *OCSP_resp_get0_certs(const OCSP_BASICRESP *bs);
.Ft int
.Fo OCSP_resp_get0_signer
.Fa "OCSP_BASICRESP *bs"
.Fa "X509 **signer"
.Fa "STACK_OF(X509) *extra_certs"
.Fc
.Ft int
.Fo OCSP_resp_get0_id
.Fa "const OCSP_BASICRESP *bs"
.Fa "const ASN1_OCTET_STRING **pid"
.Fa "const X509_NAME **pname"
.Fc
.Ft int
.Fo OCSP_resp_get1_id
.Fa "const OCSP_BASICRESP *bs"
.Fa "ASN1_OCTET_STRING **pid"
.Fa "X509_NAME **pname"
.Fc
