.Fa "OSSL_DECODER *decoder"
.Fc
.Ft void
.Fo OSSL_DECODER_free
.Fa "OSSL_DECODER *decoder"
.Fc
.Ft const OSSL_PROVIDER *
.Fo OSSL_DECODER_get0_provider
.Fa "const OSSL_DECODER *decoder"
.Fc
.Ft const char *
.Fo OSSL_DECODER_get0_properties
.Fa "const OSSL_DECODER *decoder"
.Fc
.Ft int
