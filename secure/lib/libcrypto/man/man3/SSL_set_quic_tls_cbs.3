.Dd 2025-09-30
.Dt SSL_SET_QUIC_TLS_CBS 3ossl
.Os
.Sh NAME
.Nm OSSL_FUNC_SSL_QUIC_TLS_crypto_send_fn ,
.Nm OSSL_FUNC_SSL_QUIC_TLS_crypto_recv_rcd_fn ,
.Nm OSSL_FUNC_SSL_QUIC_TLS_crypto_release_rcd_fn ,
.Nm OSSL_FUNC_SSL_QUIC_TLS_yield_secret_fn ,
.Nm OSSL_FUNC_SSL_QUIC_TLS_got_transport_params_fn ,
.Nm OSSL_FUNC_SSL_QUIC_TLS_alert_fn ,
.Nm SSL_set_quic_tls_cbs ,
.Nm SSL_set_quic_tls_transport_params ,
.Nm SSL_set_quic_tls_early_data_enabled
.Nd Use the OpenSSL TLS implementation for a third party QUIC implementation
.Sh SYNOPSIS
.In openssl/ssl.h
.Ft /* QUIC TLS callbacks available via an OSSL_DISPATCH table */

 /* Function id: OSSL_FUNC_SSL_QUIC_TLS_CRYPTO_SEND */
 typedef int
.Fo 
.Fa *OSSL_FUNC_SSL_QUIC_TLS_crypto_send_fn
.Fc
(SSL *s,
.Bd -literal
                                                      const unsigned char *buf,
                                                      size_t buf_len,
                                                      size_t *consumed,
                                                      void *arg);
.Ed
.Ft /* Function id: OSSL_FUNC_SSL_QUIC_TLS_CRYPTO_RECV_RCD */
 typedef int
.Fo 
.Fa *OSSL_FUNC_SSL_QUIC_TLS_crypto_recv_rcd_fn
.Fc
(SSL *s,
.Bd -literal
                                                    const unsigned char **buf,
                                                    size_t *bytes_read,
                                                    void *arg);
.Ed
.Ft /* Function id: OSSL_FUNC_SSL_QUIC_TLS_CRYPTO_RELEASE_RCD */
 typedef int
.Fo 
.Fa *OSSL_FUNC_SSL_QUIC_TLS_crypto_release_rcd_fn
.Fc
(SSL *,
.Bd -literal
                                                             size_t bytes_read,
                                                             void *arg);
.Ed
.Ft /* Function id: OSSL_FUNC_SSL_QUIC_TLS_YIELD_SECRET */
 typedef int
.Fo 
.Fa *OSSL_FUNC_SSL_QUIC_TLS_yield_secret_fn
.Fc
(SSL *s,
.Bd -literal
                                                    uint32_t prot_level,
                                                    int direction,
                                                    const unsigned char *secret,
                                                    size_t secret_len,
                                                    void *arg);
.Ed
.Ft /* Function id: OSSL_FUNC_SSL_QUIC_TLS_GOT_TRANSPORT_PARAMS */
 typedef int
.Fo 
.Fa *OSSL_FUNC_SSL_QUIC_TLS_got_transport_params_fn
.Fc
(SSL *s,
.Bd -literal
                                                    const unsigned char *params,
                                                    size_t params_len,
                                                    void *arg);
.Ed
.Ft /* Function id: OSSL_FUNC_SSL_QUIC_TLS_ALERT */
 typedef int
.Fo 
.Fa *OSSL_FUNC_SSL_QUIC_TLS_alert_fn
.Fc
(SSL *s,
.Bd -literal
                                                unsigned char alert_code,
                                                void *arg);
.Ed
.Ft int
.Fo SSL_set_quic_tls_cbs
.Fa "SSL *s"
.Fa "const OSSL_DISPATCH *qtdis"
.Fa "void *arg"
.Fc
.Ft int
.Fo SSL_set_quic_tls_transport_params
.Fa "SSL *s"
.Fa "const unsigned char *params"
.Fa "size_t params_len"
.Fc
.Ft int
.Fo SSL_set_quic_tls_early_data_enabled
.Fa "SSL *s"
.Fa "int enabled"
.Fc
.Sh DESCRIPTION
.Fn SSL_set_quic_tls_cbs
can be used to replace the standard TLS record layer with a custom
record layer for use by a third party QUIC implementation.
For the given SSL object
.Fa s ,
a set of callbacks are supplied in an
.Sy OSSL_DISPATCH
table via
.Fa qtdis .
The
.Fa arg
parameter will be passed as an argument when the various callbacks are
called.
.Pp
An
.Sy OSSL_DISPATCH
table should consist of an array of
.Sy OSSL_DISPATCH
entries where each entry is a function id, and a function pointer.
The array should be terminated with an empty entry (i.e.
a 0 function id, and a NULL function pointer).
.Pp
Calling the
.Fn SSL_set_quic_tls_cbs
function will switch off the
.Sy SSL_OP_ENABLE_MIDDLEBOX_COMPAT
option (if set).
See
.Xr SSL_set_options 3 .
Additionally the minimum TLS protocol version will be set to
TLS1_3_VERSION. It is an error to call this function with anything other
than a TLS connection SSL object.
.Pp
The OSSL_FUNC_SSL_QUIC_TLS_crypto_send_fn callback (function id
.Sy OSSL_FUNC_SSL_QUIC_TLS_CRYPTO_SEND )
is called when CRYPTO frame data should be sent to the peer.
The data to be sent is supplied in the buffer
.Em buf
which is of length
.Em buf_len .
The callback may choose to consume less data than was supplied in the
buffer.
On successful completion of the callback the
.Em consumed
parameter should be populated with the amount of data that the callback
consumed.
This should be less than or equal to the value in
.Em buf_len .
CRYPTO data should be sent using the most recent write encryption level
set via the OSSL_FUNC_SSL_QUIC_TLS_yield_secret_fn callback (if it has
been called).
.Pp
The OSSL_FUNC_SSL_QUIC_TLS_crypto_recv_rcd_fn callback (function id
.Sy OSSL_FUNC_SSL_QUIC_TLS_CRYPTO_RECV_RCD )
is used to receive CRYPTO frame data from the peer.
When OpenSSL wants to read data from the peer this callback is called.
The callback should populate
.Em *buf
with a pointer to a buffer containing CRYPTO data that has been received
from the peer.
The size of the buffer should be populated in
.Em *bytes_read .
The buffer should remain valid until OpenSSL calls the
OSSL_FUNC_SSL_QUIC_TLS_crypto_release_rcd_fn callback.
CRYPTO frame data is assumed to have been decrypted using the most
recent read protection level set via the yield_secret_cb callback (if it
has been called).
.Pp
The OSSL_FUNC_SSL_QUIC_TLS_crypto_release_rcd_fn callback (function id
.Sy OSSL_FUNC_SSL_QUIC_TLS_CRYPTO_RELEASE_RCD )
is called when data previously read via
OSSL_FUNC_SSL_QUIC_TLS_crypto_recv_rcd_fn is no longer required.
The
.Em bytes_read
argument is always equal to the size of the buffer previously provided
in the crypto_receive_rcd_cb callback.
Only one record at a time will ever be read by OpenSSL.
.Pp
The OSSL_FUNC_SSL_QUIC_TLS_yield_secret_fn callback (function id
.Sy OSSL_FUNC_SSL_QUIC_TLS_YIELD_SECRET )
is called when a new secret has been established.
The
.Em prot_level
argument identities the TLS protection level and will be one of
.Sy OSSL_RECORD_PROTECTION_LEVEL_NONE ,
.Sy OSSL_RECORD_PROTECTION_LEVEL_EARLY ,
.Sy OSSL_RECORD_PROTECTION_LEVEL_HANDSHAKE
or
.Sy OSSL_RECORD_PROTECTION_LEVEL_APPLICATION .
The
.Em direction
will either be 0 (for the read secret) or 1 (for the write secret).
The secret itself will be in the buffer pointed to by
.Em secret
and the buffer will be of length
.Em secret_len .
.Pp
The OSSL_FUNC_SSL_QUIC_TLS_got_transport_params_fn callback (function id
.Sy OSSL_FUNC_SSL_QUIC_TLS_GOT_TRANSPORT_PARAMS )
is called when transport parameters have been received from the peer.
The parameters are held in the
.Fa params
buffer which is of length
.Fa params_len .
.Pp
The OSSL_FUNC_SSL_QUIC_TLS_alert_fn callback (function id
.Sy OSSL_FUNC_SSL_QUIC_TLS_ALERT )
is called when OpenSSL is attempting to send an alert to the peer.
The code for the alert is supplied in
.Em alert_code .
.Pp
The
.Fn SSL_set_quic_tls_transport_params
function is used to set the transport parameters to be sent by this
endpoint.
The parameters are in the
.Fa params
buffer which should be of length
.Fa params_len .
The buffer containing the parameters should remain valid until after the
parameters have been sent.
This function must have been called by the time the transport parameters
need to be sent.
For a client this will be before the connection has been initiated.
For a server this might typically occur during the
got_transport_params_cb.
.Pp
The
.Fn SSL_set_quic_tls_early_data_enabled
function is used to enable the 0-RTT feature for a third party QUIC
implementation.
.Sh RETURN VALUES
These functions return 1 on success and 0 on failure.
.Pp
All of the callbacks should also return 1 on success and 0 on failure.
A failure response is fatal to the connection.
.Sh EXAMPLES
A call to
.Fn SSL_set_quic_tls_cbs
might look something like the following, given suitable definitions of
the various callback functions:
.Bd -literal
 const OSSL_DISPATCH qtdis[] = {
     {OSSL_FUNC_SSL_QUIC_TLS_CRYPTO_SEND, (void (*)(void))crypto_send_cb},
     {OSSL_FUNC_SSL_QUIC_TLS_CRYPTO_RECV_RCD,
         (void (*)(void))crypto_recv_rcd_cb},
     {OSSL_FUNC_SSL_QUIC_TLS_CRYPTO_RELEASE_RCD,
         (void (*)(void))crypto_release_rcd_cb},
     {OSSL_FUNC_SSL_QUIC_TLS_YIELD_SECRET,
         (void (*)(void))yield_secret_cb},
     {OSSL_FUNC_SSL_QUIC_TLS_GOT_TRANSPORT_PARAMS,
         (void (*)(void))got_transport_params_cb},
     {OSSL_FUNC_SSL_QUIC_TLS_ALERT, (void (*)(void))alert_cb},
     {0, NULL}
  };

 if (!SSL_set_quic_tls_cbs(ssl, qtdis, NULL))
     goto err;
.Ed
