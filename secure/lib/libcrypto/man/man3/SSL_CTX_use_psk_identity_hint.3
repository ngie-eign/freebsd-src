.Dd 2025-09-30
.Dt SSL_CTX_USE_PSK_IDENTITY_HINT 3ossl
.Os
.Sh NAME
.Nm SSL_psk_server_cb_func ,
.Nm SSL_psk_find_session_cb_func ,
.Nm SSL_CTX_use_psk_identity_hint ,
.Nm SSL_use_psk_identity_hint ,
.Nm SSL_CTX_set_psk_server_callback ,
.Nm SSL_set_psk_server_callback ,
.Nm SSL_CTX_set_psk_find_session_callback ,
.Nm SSL_set_psk_find_session_callback
.Nd set PSK identity hint to use
.Sh SYNOPSIS
.In openssl/ssl.h
