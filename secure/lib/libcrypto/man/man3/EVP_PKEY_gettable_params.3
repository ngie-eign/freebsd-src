.Dd 2025-09-30
.Dt EVP_PKEY_GETTABLE_PARAMS 3ossl
.Os
.Sh NAME
.Nm EVP_PKEY_gettable_params ,
.Nm EVP_PKEY_get_params ,
.Nm EVP_PKEY_get_int_param ,
.Nm EVP_PKEY_get_size_t_param ,
.Nm EVP_PKEY_get_bn_param ,
.Nm EVP_PKEY_get_utf8_string_param ,
.Nm EVP_PKEY_get_octet_string_param
.Nd retrieve key parameters from a key
.Sh SYNOPSIS
.In openssl/evp.h
.Ft const OSSL_PARAM *
.Fo EVP_PKEY_gettable_params
.Fa "EVP_PKEY *pkey"
.Fc
.Ft int
.Fo EVP_PKEY_get_params
.Fa "const EVP_PKEY *pkey"
.Fa "OSSL_PARAM params[]"
.Fc
.Ft int
.Fo EVP_PKEY_get_int_param
.Fa "const EVP_PKEY *pkey"
.Fa "const char *key_name"
.Fa "int *out"
.Fc
.Ft int
.Fo EVP_PKEY_get_size_t_param
.Fa "const EVP_PKEY *pkey"
.Fa "const char *key_name"
.Fa "size_t *out"
.Fc
.Ft int
.Fo EVP_PKEY_get_bn_param
.Fa "const EVP_PKEY *pkey"
.Fa "const char *key_name"
.Fa "BIGNUM **bn"
.Fc
.Ft int
.Fo EVP_PKEY_get_utf8_string_param
.Fa "const EVP_PKEY *pkey"
.Fa "const char *key_name"
.Fa "char *str"
.Fa "size_t max_buf_sz"
.Fa "size_t *out_len"
.Fc
.Ft int
.Fo EVP_PKEY_get_octet_string_param
.Fa "const EVP_PKEY *pkey"
.Fa "const char *key_name"
.Fa "unsigned char *buf"
.Fa "size_t max_buf_sz"
.Fa "size_t *out_len"
.Fc
.Sh DESCRIPTION
See
.Xr OSSL_PARAM 3
for information about parameters.
.Pp
.Fn EVP_PKEY_get_params
retrieves parameters from the key
.Fa pkey ,
according to the contents of
.Em params .
.Pp
.Fn EVP_PKEY_gettable_params
returns a constant list of
.Em params
indicating the names and types of key parameters that can be retrieved.
.Pp
An
.Xr OSSL_PARAM 3
of type
.Sy OSSL_PARAM_INTEGER
or
.Sy OSSL_PARAM_UNSIGNED_INTEGER
is of arbitrary length.
Such a parameter can be obtained using any of the functions
.Fn EVP_PKEY_get_int_param ,
.Fn EVP_PKEY_get_size_t_param
or
.Fn EVP_PKEY_get_bn_param .
Attempting to obtain an integer value that does not fit into a native C
.Vt int
type will cause
.Fn EVP_PKEY_get_int_param
to fail.
Similarly attempting to obtain an integer value that is negative or does
not fit into a native C
.Vt size_t
type using
.Fn EVP_PKEY_get_size_t_param
will also fail.
.Pp
.Fn EVP_PKEY_get_int_param
retrieves a key
.Fa pkey
integer value
.Em *out
associated with a name of
.Fa key_name
if it fits into
.Qo Li int Qc
type.
For parameters that do not fit into
.Qo Li int Qc
use
.Fn EVP_PKEY_get_bn_param .
.Pp
.Fn EVP_PKEY_get_size_t_param
retrieves a key
.Fa pkey
size_t value
.Em *out
associated with a name of
.Fa key_name
if it fits into
.Qo Li size_t Qc
type.
For parameters that do not fit into
.Qo Li size_t Qc
use
.Fn EVP_PKEY_get_bn_param .
.Pp
.Fn EVP_PKEY_get_bn_param
retrieves a key
.Fa pkey
BIGNUM value
.Em **bn
associated with a name of
.Fa key_name .
If
.Em *bn
is NULL then the BIGNUM is allocated by the method.
.Pp
.Fn EVP_PKEY_get_utf8_string_param
get a key
.Fa pkey
UTF8 string value into a buffer
.Fa str
of maximum size
.Fa max_buf_sz
associated with a name of
.Fa key_name .
The maximum size must be large enough to accommodate the string value
including a terminating NUL byte, or this function will fail.
If
.Fa out_len
is not NULL,
.Em *out_len
is set to the length of the string not including the terminating NUL
byte.
The required buffer size not including the terminating NUL byte can be
obtained from
.Em *out_len
by calling the function with
.Fa str
set to NULL.
.Pp
.Fn EVP_PKEY_get_octet_string_param
get a key
.Fa pkey Ns 's
octet string value into a buffer
.Fa buf
of maximum size
.Fa max_buf_sz
associated with a name of
.Fa key_name .
If
.Fa out_len
is not NULL,
.Em *out_len
is set to the length of the contents.
The required buffer size can be obtained from
.Em *out_len
by calling the function with
.Fa buf
set to NULL.
.Sh NOTES
These functions only work for
.Vt EVP_PKEY Ns s
that contain a provider side key.
.Sh RETURN VALUES
.Fn EVP_PKEY_gettable_params
returns NULL on error or if it is not supported.
.Pp
All other methods return 1 if a value associated with the key's
.Fa key_name
was successfully returned, or 0 if there was an error.
An error may be returned by methods
.Fn EVP_PKEY_get_utf8_string_param
and
.Fn EVP_PKEY_get_octet_string_param
if
.Fa max_buf_sz
is not big enough to hold the value.
If
.Fa out_len
is not NULL,
.Em *out_len
will be assigned the required buffer size to hold the value.
.Sh EXAMPLES
.Bd -literal
 #include <openssl/evp.h>

 char curve_name[64];
 unsigned char pub[256];
 BIGNUM *bn_priv = NULL;

 /*
  * NB: assumes 'key' is set up before the next step. In this example the key
  * is an EC key.
  */

 if (!EVP_PKEY_get_utf8_string_param(key, OSSL_PKEY_PARAM_GROUP_NAME,
                                     curve_name, sizeof(curve_name), &len)) {
   /* Error */
 }
 if (!EVP_PKEY_get_octet_string_param(key, OSSL_PKEY_PARAM_PUB_KEY,
                                      pub, sizeof(pub), &len)) {
     /* Error */
 }
 if (!EVP_PKEY_get_bn_param(key, OSSL_PKEY_PARAM_PRIV_KEY, &bn_priv)) {
     /* Error */
 }

 BN_clear_free(bn_priv);
.Ed
.Sh SEE ALSO
