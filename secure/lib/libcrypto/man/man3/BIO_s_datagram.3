.Dd 2025-09-30
.Dt BIO_S_DATAGRAM 3ossl
.Os
.Sh NAME
.Nm BIO_s_datagram ,
.Nm BIO_new_dgram ,
.Nm BIO_ctrl_dgram_connect ,
.Nm BIO_ctrl_set_connected ,
