.Dd 2025-09-30
.Dt OPENSSL-RSA 1ossl
.Os
.Sh NAME
.Nm openssl-rsa
.Nd RSA key processing command
.Sh SYNOPSIS
.Nm openssl
.Ar rsa
.Oo
.Fl help ]
.Oo
.Fl inform
.Ar DER Ns | Ns Ar PEM Ns | Ns Ar P12 Ns | Ns Ar ENGINE ]
.Oo
.Fl outform
.Ar DER Ns | Ns Ar PEM ]
.Oo
.Fl in
.Em filename Ns | Ns Em uri ]
.Oo
.Fl passin
.Em arg ]
.Oo
.Fl out
.Em filename ]
.Oo
.Fl passout
.Em arg ]
.Oo
.Fl aes128 ]
.Oo
.Fl aes192 ]
.Oo
.Fl aes256 ]
.Oo
.Fl aria128 ]
.Oo
.Fl aria192 ]
.Oo
.Fl aria256 ]
.Oo
.Fl camellia128 ]
.Oo
.Fl camellia192 ]
.Oo
.Fl camellia256 ]
.Oo
.Fl des ]
.Oo
.Fl des3 ]
.Oo
.Fl idea ]
.Oo
.Fl text ]
.Oo
