.Oo
.Fl dateopt ]
.Oo
.Fl text ]
.Oo
.Fl in
.Em filename ]
.Oo
.Fl out
.Em filename ]
.Oo
.Fl gendelta
.Em filename ]
.Oo
.Fl badsig ]
.Oo
.Fl verify ]
.Oo
.Fl noout ]
.Oo
.Fl hash ]
.Oo
.Fl hash_old ]
.Oo
.Fl fingerprint ]
.Oo
.Fl crlnumber ]
.Oo
.Fl issuer ]
.Oo
.Fl lastupdate ]
.Oo
.Fl nextupdate ]
.Oo
.Fl nameopt
.Em option ]
.Oo
