.Dd 2025-09-30
.Dt OPENSSL-SPKAC 1ossl
.Os
.Sh NAME
.Nm openssl-spkac
.Nd SPKAC printing and generating command
.Sh SYNOPSIS
.Nm openssl
.Ar spkac
.Oo
.Fl help ]
.Oo
.Fl in
.Em filename ]
.Oo
.Fl out
.Em filename ]
.Oo
.Fl digest
.Em digest ]
.Oo
.Fl key
.Em filename Ns | Ns Em uri ]
.Oo
.Fl keyform
.Ar DER Ns | Ns Ar PEM Ns | Ns Ar P12 Ns | Ns Ar ENGINE ]
.Oo
.Fl passin
.Em arg ]
.Oo
.Fl challenge
.Em string ]
.Oo
.Fl pubkey ]
.Oo
.Fl spkac
.Em spkacname ]
.Oo
.Fl spksect
.Em section ]
.Oo
.Fl noout ]
.Oo
.Fl verify ]
.Oo
.Fl engine
.Em id ]
.Oo
.Fl provider
.Em name ]
.Oo
.Fl provider-path
.Em path ]
.Oo
.Fl provparam
.Em [name:]key=value ]
.Oo
