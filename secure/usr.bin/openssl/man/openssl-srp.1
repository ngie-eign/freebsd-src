.Os
.Sh NAME
.Nm openssl-srp
.Nd maintain SRP password file
.Sh SYNOPSIS
.Nm openssl srp
.Oo
.Fl help ]
.Oo
.Fl verbose ]
.Oo
.Fl add ]
.Oo
.Fl modify ]
.Oo
.Fl delete ]
.Oo
.Fl list ]
.Oo
.Fl name
.Em section ]
.Oo
.Fl srpvfile
.Em file ]
.Oo
