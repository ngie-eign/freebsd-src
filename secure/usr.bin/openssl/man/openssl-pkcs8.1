.Dd 2025-09-30
.Dt OPENSSL-PKCS8 1ossl
.Os
.Sh NAME
.Nm openssl-pkcs8
.Nd PKCS#8 format private key conversion command
.Sh SYNOPSIS
.Nm openssl
.Ar pkcs8
.Oo
.Fl help ]
.Oo
.Fl topk8 ]
.Oo
.Fl inform
.Ar DER Ns | Ns Ar PEM ]
.Oo
.Fl outform
.Ar DER Ns | Ns Ar PEM ]
.Oo
.Fl in
.Em filename ]
.Oo
.Fl passin
.Em arg ]
.Oo
.Fl out
.Em filename ]
.Oo
.Fl passout
.Em arg ]
.Oo
.Fl iter
.Em count ]
.Oo
.Fl noiter ]
.Oo
.Fl nocrypt ]
.Oo
.Fl traditional ]
.Oo
.Fl v2
.Em alg ]
.Oo
.Fl v2prf
.Em alg ]
.Oo
.Fl v1
.Em alg ]
.Oo
.Fl scrypt ]
.Oo
.Fl scrypt_N
.Em N ]
.Oo
.Fl scrypt_r
.Em r ]
.Oo
.Fl scrypt_p
.Em p ]
.Oo
.Fl saltlen
.Em size ]
.Oo
.Fl rand
.Em files ]
.Oo
.Fl writerand
.Em file ]
