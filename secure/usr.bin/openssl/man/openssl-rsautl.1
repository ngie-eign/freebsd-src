.Dd 2025-09-30
.Dt OPENSSL-RSAUTL 1ossl
.Os
.Sh NAME
.Nm openssl-rsautl
.Nd RSA command
.Sh SYNOPSIS
.Nm openssl
.Ar rsautl
.Oo
.Fl help ]
.Oo
.Fl in
.Em file ]
.Oo
.Fl passin
.Em arg ]
.Oo
.Fl rev ]
.Oo
.Fl out
.Em file ]
.Oo
.Fl inkey
.Em filename Ns | Ns Em uri ]
.Oo
.Fl keyform
.Ar DER Ns | Ns Ar PEM Ns | Ns Ar P12 Ns | Ns Ar ENGINE ]
.Oo
.Fl pubin ]
.Oo
.Fl certin ]
.Oo
.Fl sign ]
.Oo
.Fl verify ]
.Oo
.Fl encrypt ]
.Oo
.Fl decrypt ]
.Oo
.Fl pkcs ]
.Oo
.Fl x931 ]
.Oo
.Fl oaep ]
.Oo
.Fl raw ]
.Oo
.Fl hexdump ]
.Oo
.Fl asn1parse ]
.Oo
.Fl engine
.Em id ]
.Oo
.Fl rand
.Em files ]
.Oo
.Fl writerand
.Em file ]
.Oo
.Fl provider
